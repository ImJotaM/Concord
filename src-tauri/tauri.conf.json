{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Concord",
  "version": "1.0.0",
  "identifier": "com.concord.lan",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Concord",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "Concord LAN - High-Speed Voice, Video & Text Chat",
    "longDescription": "High-speed LAN Voice, Screen Share, Direct Messages and Text Chat Application for local network communities and LAN parties.",
    "copyright": "Copyright © 2026 Concord",
    "category": "SocialNetworking",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "../server/dist/**/*",
      "../server/package.json",
      "../server/node_modules/**/*"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
